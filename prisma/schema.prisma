generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  PC
  CONSOLE
  MIXED
}

enum LegalForm {
  CLUB
  ASSOCIATION
}

enum PlayerRole {
  TANK
  DPS_HITSCAN
  DPS_FLEX
  MAIN_SUPPORT
  FLEX_SUPPORT
}

enum RankDivision {
  UNRANKED
  BRONZE
  SILVER
  GOLD
  PLATINUM
  EMERALD
  DIAMOND
  MASTER
  GRANDMASTER
  CHAMPION
}

enum RosterStatus {
  STARTER
  SUBSTITUTE
  TRIAL
}

enum UserRole {
  PLAYER
  MANAGER
  COACH
  CASTER
  STAFF
  ADMIN
}

enum StaffRole {
  COACH
  ASSISTANT_COACH
  ANALYST
}

enum OpenFlag {
  CLOSED
  OPEN
}

enum TeamLeadership {
  MANAGER
  CAPTAIN
}

enum TeamFormat {
  STANDARD_5V5
  CUSTOM
}

enum TeamSeatKind {
  PRIMARY
  CO_MANAGER
}

enum InvitationKind {
  PLAYER
  COACH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RecruitmentStatus {
  LOOKING
  NOT_LOOKING
}

enum SpokenLanguage {
  FR
  EN
  DE
  ES
  IT
  PT
  PL
  RU
  KO
  JA
  ZH
  NL
  SV
  TR
  AR
}

model User {
  id                      String                   @id
  name                    String
  email                   String
  emailVerified           Boolean                  @default(false)
  pendingEmail            String?
  discord                 String                   @default("")
  isDiscordPublic         Boolean                  @default(false)
  discordId               String?                  @unique
  discordUsername         String                   @default("")
  discordDmBlocked        Boolean                  @default(false)
  notifyDiscordMessages      Boolean                  @default(true)
  notifyDiscordInvitations   Boolean                  @default(true)
  notifyDiscordScrims        Boolean                  @default(true)
  notifyDiscordCancellations Boolean                  @default(true)
  image                   String?
  role                    UserRole                 @default(PLAYER)
  isManager               Boolean                  @default(false)
  isPlayer                Boolean                  @default(true)
  isCoach                 Boolean                  @default(false)
  isCaster                Boolean                  @default(false)
  isStaff                 Boolean                  @default(false)
  openToCast              OpenFlag                 @default(CLOSED)
  openToCoach             OpenFlag                 @default(CLOSED)
  deactivatedAt           DateTime?
  anonymizeAfter          DateTime?
  anonymizedAt            DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  accounts                Account[]
  teams                   Team[]
  ownedStructures         Structure[]              @relation("OwnedStructures")
  sentStructureInvites    StructureInvitation[]    @relation("StructureInviteSender")
  sentClubInvites         ClubInvitation[]         @relation("ClubInviteSender")
  staffMemberships        StructureStaff[]
  playerProfile           PlayerProfile?
  casterProfile           CasterProfile?
  rosterSlots             Player[]
  sentInvitations         TeamInvitation[]         @relation("SentInvitations")
  receivedInvitations     TeamInvitation[]         @relation("ReceivedInvitations")
  chatsAsRecruiter        Conversation[]           @relation("ChatRecruiter")
  chatsAsCandidate        Conversation[]           @relation("ChatCandidate")
  chatMessages            ChatMessage[]
  reportsFiled            Report[]                 @relation("ReportsFiled")
  reportsReceived         Report[]                 @relation("ReportsReceived")
  teamSeats               TeamSeat[]
  teamCoaches             TeamCoach[]
  teamPermissions         TeamPermission[]
  scrimsRecorded          Scrim[]
  scrimProposalsSent      ScrimProposal[]          @relation("ScrimProposalAuthor")
  scrimProposalsCancelled ScrimProposal[]          @relation("ScrimProposalCanceller")
  discordIntegrations     TeamDiscordIntegration[] @relation("DiscordIntegrationInstaller")
  notificationOutbox      NotificationOutbox[]
  announcementsCreated    Announcement[]
  openPositionApplications OpenPositionApplication[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Jetons Better Auth (reset mot de passe, vérif email) : identifier + value hashée + expiresAt. Le flag User.emailVerified reflète la confirmation.
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Structure {
  id            String                @id @default(cuid())
  name          String
  tag           String                @unique
  logoUrl       String?
  ownerId       String
  owner         User                  @relation("OwnedStructures", fields: [ownerId], references: [id], onDelete: Restrict)
  teams         Team[]
  invitations   StructureInvitation[]
  staff         StructureStaff[]
  announcements Announcement[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([ownerId])
}

model Team {
  id                   String                  @id @default(cuid())
  name                 String
  structure            LegalForm
  platform             Platform
  language             SpokenLanguage          @default(FR)
  estimatedSr          Int                     @default(0)
  format               TeamFormat              @default(STANDARD_5V5)
  managerId            String
  manager              User                    @relation(fields: [managerId], references: [id], onDelete: Cascade)
  leadership           TeamLeadership          @default(MANAGER)
  orgId                String?
  org                  Structure?              @relation(fields: [orgId], references: [id], onDelete: SetNull)
  parentTeamId         String?
  parentTeam           Team?                   @relation("AcademyTree", fields: [parentTeamId], references: [id], onDelete: SetNull)
  academyTeams         Team[]                  @relation("AcademyTree")
  players              Player[]
  invitations          TeamInvitation[]
  structureInvites     StructureInvitation[]
  clubInvitesAsParent  ClubInvitation[]        @relation("ClubInviteParent")
  clubInvitesAsChild   ClubInvitation[]        @relation("ClubInviteChild")
  officialSchedules    OfficialSchedule[]
  reports              Report[]
  seats                TeamSeat[]
  coaches              TeamCoach[]
  permissions          TeamPermission[]
  scrims               Scrim[]
  scrimsAsOpponent     Scrim[]                 @relation("ScrimOpponent")
  proposalsSent        ScrimProposal[]         @relation("ScrimProposalFrom")
  proposalsReceived    ScrimProposal[]         @relation("ScrimProposalTo")
  proposalsCancelled   ScrimProposal[]         @relation("ScrimProposalCancelledByTeam")
  scrimConfig          TeamScrimConfig?
  discordIntegration   TeamDiscordIntegration?
  announcements        Announcement[]
  notificationOutbox   NotificationOutbox[]
  conversationContexts Conversation[]
  openPositions        OpenPosition[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([platform])
  @@index([language])
  @@index([estimatedSr])
  @@index([managerId])
  @@index([orgId])
  @@index([parentTeamId])
}

model OpenPosition {
  id            String                     @id @default(cuid())
  teamId        String
  team          Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role          PlayerRole
  createdAt     DateTime                   @default(now())
  applications  OpenPositionApplication[]
  announcements Announcement[]

  @@unique([teamId, role])
  @@index([teamId, createdAt])
  @@index([role])
}

model OpenPositionApplication {
  id             String       @id @default(cuid())
  positionId     String
  position       OpenPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  playerId       String
  player         User         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  conversationId String?
  createdAt      DateTime     @default(now())

  @@unique([positionId, playerId])
  @@index([playerId, createdAt])
}

model Player {
  id             String       @id @default(cuid())
  battleTag      String
  role           PlayerRole
  sr             Int
  rankDivision   RankDivision
  status         RosterStatus
  favoriteHeroes String[]
  experience     String       @default("")
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([sr])
  @@index([userId])
}

model PlayerProfile {
  id                String               @id @default(cuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleTag         String               @default("")
  sr                Int                  @default(0)
  role              PlayerRole           @default(TANK)
  favoriteHeroes    String[]
  experience        String               @default("")
  recruitmentStatus RecruitmentStatus    @default(LOOKING)
  languages         SpokenLanguage[]     @default([])
  displayName       String               @default("")
  openToPlay        PlayerRole[]         @default([])
  battleTagPublic   Boolean              @default(false)
  availabilities    WeeklyAvailability[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([sr])
  @@index([sr, role])
  @@index([languages], type: Gin)
  @@index([openToPlay], type: Gin)
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User             @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String
  invitee     User             @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)
  status      InvitationStatus @default(PENDING)
  kind        InvitationKind   @default(PLAYER)
  message     String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  respondedAt DateTime?

  @@unique([teamId, inviteeId])
  @@index([inviteeId, status])
  @@index([teamId, status])
}

model TeamSeat {
  id        String       @id @default(cuid())
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      TeamSeatKind @default(PRIMARY)
  createdAt DateTime     @default(now())

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, kind])
}

enum TeamGrantRole {
  COACH
  ASSISTANT_COACH
  CAPTAIN
}

model TeamPermission {
  id                      String        @id @default(cuid())
  teamId                  String
  team                    Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                    TeamGrantRole
  canEditOfficialSchedule Boolean       @default(false)
  canRecordScrim          Boolean       @default(false)
  canProposeScrim         Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, role])
}

enum ScrimMapPool {
  OFFICIEL
  ALTERNATIVE
  LOOSERPICK
  CUSTOM
}

enum ScrimLobbyHostPref {
  NOUS_UNIQUEMENT
  PREFERENCE_NOUS
  PEU_IMPORTE
  PREFERENCE_VOUS
  VOUS_UNIQUEMENT
}

model TeamScrimConfig {
  id               String             @id @default(cuid())
  teamId           String             @unique
  team             Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  discordManager   String             @default("")
  battleTagContact String             @default("")
  stagger          Boolean            @default(false)
  povStream        Boolean            @default(false)
  mapPool          ScrimMapPool       @default(OFFICIEL)
  lobbyHost        ScrimLobbyHostPref @default(PEU_IMPORTE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([teamId])
}

enum ScrimProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ScrimCancellationReason {
  ROSTER_UNAVAILABLE
  TECHNICAL_ISSUE
  SCHEDULE_ERROR
  OTHER
}

model ScrimProposal {
  id                  String                   @id @default(cuid())
  fromTeamId          String
  fromTeam            Team                     @relation("ScrimProposalFrom", fields: [fromTeamId], references: [id], onDelete: Cascade)
  toTeamId            String
  toTeam              Team                     @relation("ScrimProposalTo", fields: [toTeamId], references: [id], onDelete: Cascade)
  weekStartDate       DateTime                 @db.Date
  weekday             String
  slot                OfficialScrimSlot
  status              ScrimProposalStatus      @default(PENDING)
  createdById         String
  createdBy           User                     @relation("ScrimProposalAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  cancellationReason  ScrimCancellationReason?
  cancellationDetails String                   @default("")
  cancelledAt         DateTime?
  cancelledById       String?
  cancelledBy         User?                    @relation("ScrimProposalCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledByTeamId   String?
  cancelledByTeam     Team?                    @relation("ScrimProposalCancelledByTeam", fields: [cancelledByTeamId], references: [id], onDelete: SetNull)
  conversations       Conversation[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  respondedAt         DateTime?

  @@index([toTeamId, status])
  @@index([fromTeamId, status])
  @@index([weekStartDate, weekday, slot])
  @@index([createdById])
  @@index([cancelledById])
  @@index([cancelledByTeamId, cancelledAt])
}

model TeamCoach {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model StructureInvitation {
  id              String           @id @default(cuid())
  structureId     String
  structure       Structure        @relation(fields: [structureId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviterId       String
  inviter         User             @relation("StructureInviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  requestedByTeam Boolean          @default(false)
  status          InvitationStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  respondedAt     DateTime?

  @@unique([structureId, teamId])
  @@index([teamId, status])
  @@index([structureId, status])
}

model ClubInvitation {
  id           String           @id @default(cuid())
  parentTeamId String
  parentTeam   Team             @relation("ClubInviteParent", fields: [parentTeamId], references: [id], onDelete: Cascade)
  childTeamId  String
  childTeam    Team             @relation("ClubInviteChild", fields: [childTeamId], references: [id], onDelete: Cascade)
  inviterId    String
  inviter      User             @relation("ClubInviteSender", fields: [inviterId], references: [id], onDelete: Cascade)
  status       InvitationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  respondedAt  DateTime?

  @@unique([parentTeamId, childTeamId])
  @@index([parentTeamId, status])
  @@index([childTeamId, status])
}

model StructureStaff {
  id          String    @id @default(cuid())
  structureId String
  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        StaffRole
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([structureId, userId])
  @@index([userId])
  @@index([structureId, role])
}

enum DayAvailability {
  DISPO_20H
  DISPO_21H
  INCERTAIN
  INDISPO
}

enum OfficialScrimSlot {
  NONE
  SCRIM_20H
  SCRIM_21H
  VOD_REVIEW
  TOURNOI
  CUSTOM
  TBD
}

enum ScrimMapOutcome {
  WIN
  LOSS
}

enum OpponentBehavior {
  COURTOIS
  BON
  PEU_AGREABLE
  TOXIQUE_OU_TROLL
}

model Scrim {
  id                String           @id @default(cuid())
  teamId            String
  team              Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  opponentTeamId    String?
  opponentTeam      Team?            @relation("ScrimOpponent", fields: [opponentTeamId], references: [id], onDelete: SetNull)
  opponentNameInput String           @default("")
  opponentSrInput   Int?
  opponentBehavior  OpponentBehavior @default(BON)
  playedAt          DateTime         @default(now())
  createdById       String
  createdBy         User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  maps              ScrimMapResult[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([teamId, playedAt])
  @@index([createdById])
  @@index([opponentTeamId])
  @@index([opponentBehavior])
}

model ScrimMapResult {
  id        String          @id @default(cuid())
  scrimId   String
  scrim     Scrim           @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  mapName   String
  outcome   ScrimMapOutcome
  intensity Int
  sortOrder Int             @default(0)

  @@index([scrimId, sortOrder])
}

model WeeklyAvailability {
  id            String          @id @default(cuid())
  playerId      String
  player        PlayerProfile   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  weekStartDate DateTime        @db.Date
  monday        DayAvailability @default(INDISPO)
  tuesday       DayAvailability @default(INDISPO)
  wednesday     DayAvailability @default(INDISPO)
  thursday      DayAvailability @default(INDISPO)
  friday        DayAvailability @default(INDISPO)
  saturday      DayAvailability @default(INDISPO)
  sunday        DayAvailability @default(INDISPO)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([playerId, weekStartDate])
  @@index([weekStartDate])
}

model OfficialSchedule {
  id            String            @id @default(cuid())
  teamId        String
  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  weekStartDate DateTime          @db.Date
  monday        OfficialScrimSlot @default(NONE)
  tuesday       OfficialScrimSlot @default(NONE)
  wednesday     OfficialScrimSlot @default(NONE)
  thursday      OfficialScrimSlot @default(NONE)
  friday        OfficialScrimSlot @default(NONE)
  saturday      OfficialScrimSlot @default(NONE)
  sunday        OfficialScrimSlot @default(NONE)
  mondayNote    String            @default("")
  tuesdayNote   String            @default("")
  wednesdayNote String            @default("")
  thursdayNote  String            @default("")
  fridayNote    String            @default("")
  saturdayNote  String            @default("")
  sundayNote    String            @default("")
  matchSlots    String[]          @default([])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([teamId, weekStartDate])
  @@index([weekStartDate])
  @@index([matchSlots], type: Gin)
}

model CasterProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  streamUrl  String   @default("")
  vodUrl     String   @default("")
  eventsNote String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ConversationContextType {
  DIRECT
  RECRUITMENT
  SCRIM
  OPEN_POSITION
}

model Conversation {
  id              String                  @id @default(cuid())
  recruiterId     String
  recruiter       User                    @relation("ChatRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       User                    @relation("ChatCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  contextType     ConversationContextType @default(DIRECT)
  contextKey      String                  @default("direct")
  contextTeamId   String?
  contextTeam     Team?                   @relation(fields: [contextTeamId], references: [id], onDelete: SetNull)
  scrimProposalId String?
  scrimProposal   ScrimProposal?          @relation(fields: [scrimProposalId], references: [id], onDelete: SetNull)
  messages        ChatMessage[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([recruiterId, candidateId, contextKey])
  @@index([recruiterId, updatedAt])
  @@index([candidateId, updatedAt])
  @@index([contextTeamId])
  @@index([scrimProposalId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, isRead])
  @@index([isRead, senderId])
  @@index([senderId])
}

enum DiscordNotificationType {
  SCRIM_PROPOSAL
  CHAT_MESSAGE
  SCRIM_CANCELLED
  TEAM_INVITE
  STRUCTURE_INVITE
  CLUB_INVITE
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model TeamDiscordIntegration {
  id             String    @id @default(cuid())
  teamId         String    @unique
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  guildId        String
  guildName      String    @default("")
  channelId      String?
  channelName    String    @default("")
  enabled        Boolean   @default(false)
  installedById  String?
  installedBy    User?     @relation("DiscordIntegrationInstaller", fields: [installedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  lastDeliveryAt DateTime?
  lastError      String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([guildId])
  @@index([installedById])
}

model NotificationOutbox {
  id            String                   @id @default(cuid())
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type          DiscordNotificationType
  payload       Json
  dedupeKey     String                   @unique
  status        NotificationOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now())
  lockedAt      DateTime?
  lockToken     String?
  lastError     String                   @default("")
  sentAt        DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@index([lockToken])
}

model DiscordServerConfig {
  guildId          String   @id
  scrimChannelId   String   @default("")
  playerChannelId  String   @default("")
  teamChannelId    String   @default("")
  ringerChannelId  String   @default("")
  guildName        String   @default("")
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

enum AnnouncementType {
  SCRIM
  PLAYER
  TEAM
  SUB
  LFP
}

enum AnnouncementStatus {
  ACTIVE
  EXPIRED
}

enum AnnouncementPostStatus {
  PENDING
  SENDING
  SENT
  FAILED
  DELETED
}

model Announcement {
  id               String              @id @default(cuid())
  teamId           String
  team             Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  structureId      String?
  structure        Structure?          @relation(fields: [structureId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  type             AnnouncementType
  content          String
  expiresAt        DateTime
  discordMessageId String              @default("")
  discordMessageIds String[]           @default([])
  channelId        String              @default("")
  status           AnnouncementStatus  @default(ACTIVE)
  snapshot         Json?
  openPositionId   String?
  openPosition     OpenPosition?       @relation(fields: [openPositionId], references: [id], onDelete: SetNull)
  posts            AnnouncementPost[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, expiresAt])
  @@index([type, status, expiresAt])
  @@index([teamId, createdAt])
  @@index([structureId])
  @@index([openPositionId])
}

model AnnouncementPost {
  id               String                 @id @default(cuid())
  announcementId   String
  announcement     Announcement           @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  channelId        String
  guildId          String                 @default("")
  discordMessageId String                 @default("")
  status           AnnouncementPostStatus @default(PENDING)
  lastError        String                 @default("")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([announcementId, channelId])
  @@index([status])
}

enum ReportReason {
  TOXIC
  FAKE_PROFILE
  WRONG_BATTLETAG
  OTHER
}

enum ReportTargetType {
  PLAYER
  TEAM
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  reporter     User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  reason       ReportReason
  details      String           @default("")
  targetUserId String?
  targetUser   User?            @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  teamId       String?
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([createdAt])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([teamId])
}
