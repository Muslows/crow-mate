{
  "name": "ow-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-local-env.mjs next dev",
    "build": "node scripts/prisma.mjs generate && node scripts/prisma.mjs migrate deploy && next build",
    "start": "next start",
    "postinstall": "node scripts/prisma.mjs generate",
    "lint": "eslint",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/with-local-env.mjs node scripts/prisma.mjs migrate dev",
    "db:migrate:deploy": "node scripts/with-local-env.mjs node scripts/prisma.mjs migrate deploy",
    "db:up": "docker compose up -d",
    "db:cleanup": "node scripts/with-local-env.mjs npx tsx scripts/cleanup-orphan-players.ts",
    "db:seed": "node scripts/with-local-env.mjs npx tsx prisma/seed.ts",
    "discord:bot": "node scripts/with-local-env.mjs npx tsx scripts/discord-bot.ts",
    "discord:register": "node scripts/with-local-env.mjs npx tsx scripts/register-discord-commands.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "better-auth": "^1.7.5",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.27.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
