# Local Docker (`npm run db:up`). `npm run dev` always prefers this file off Vercel,
# even if the shell still has a Vercel/Supabase DATABASE_URL.
DATABASE_URL="postgresql://ow:ow@localhost:5432/ow_manager?schema=public"
DIRECT_URL="postgresql://ow:ow@localhost:5432/ow_manager?schema=public"
# USE_REMOTE_DB=1

# Supabase (Vercel / prod)
# Transaction pooler (port 6543) — runtime Prisma / Vercel
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (IPv6). Vercel often cannot reach this (P1001) — migrate is not part of `npm run build`.
# DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres"
# From your laptop: USE_REMOTE_DB=1 npm run db:migrate:deploy

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Conservé pour le seed local. L’auth runtime est Supabase Auth.

NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_la_cle_complete_copiee_du_dashboard"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Dans Supabase Auth : Redirect URLs = http://localhost:3000/auth/callback
# Confirm email ON. Site URL = NEXT_PUBLIC_SITE_URL
# Modèles d’email : Confirmation URL et Recovery URL doivent pointer vers /auth/callback

# Discord : OAuth2 utilisateur (scope identify uniquement) + MP via le bot
# présent sur le Discord officiel.
# DISCORD_CLIENT_ID = Application ID du portail (17–20 chiffres), PAS le token bot.
# Redirects OAuth2 à enregistrer à la lettre :
#   NEXT_PUBLIC_SITE_URL/api/discord/callback
#   NEXT_PUBLIC_SITE_URL/api/discord/guild/callback
# Le second sert à installer le bot sur un serveur Discord clé
# (permissions : View Channel, Send Messages, Embed Links, Manage Messages,
# plus le scope applications.commands pour /setup-scrim-channel).
# DISCORD_PUBLIC_KEY = Public Key du portail (signature des interactions HTTP).
# Interactions Endpoint URL : NEXT_PUBLIC_SITE_URL/api/discord/interactions
DISCORD_CLIENT_ID=""
# Optionnel, même valeur publique que DISCORD_CLIENT_ID
# NEXT_PUBLIC_DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_OAUTH_STATE_SECRET="replace-with-an-independent-random-secret"
# Invitation permanente https://discord.gg/… ou https://discord.com/invite/…
DISCORD_COMMUNITY_INVITE_URL=""
# Vercel Cron envoie automatiquement `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET="replace-with-a-long-random-secret"

# Requis uniquement pour l’anonymisation définitive après le délai de récupération.
SUPABASE_SERVICE_ROLE_KEY=""

# Email (Resend). Sans clé : les liens sont loggés en local, pas d’envoi en production.
# RESEND_API_KEY=""
# EMAIL_FROM="OW Manager <noreply@tondomaine.fr>"
ADMIN_ID=""
# ADMIN_IDS="idUser1,idUser2"
